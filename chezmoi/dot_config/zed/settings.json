{
  "git_panel": {
    "tree_view": true
  },
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light Soft",
    "dark": "Gruvbox Dark"
  },
  "agent_buffer_font_size": 14.0,
  "ui_font_size": 16.0,
  "ui_font_family": "Noto Sans Mono CJK SC",
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "terminal": {
    "font_family": "Hack"
  },
  "agent_buffer_font_family": "Noto Sans",
  "language_models": {
    "opencode": {
      "show_go_models": true,
      "show_zen_models": false,
      "available_models": [
        {
          "name": "deepseek-v4.1-flash",
          "display_name": "DeepSeek V4.1 Flash",
          "max_tokens": 1000000,
          "max_output_tokens": 384000,
          "subscription": "go",
          "reasoning_effort_levels": ["low", "high", "max"],
          "interleaved_reasoning": true
        }
      ]
    }
  },
  "agent": {
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^git\\b"
            },
            {
              "pattern": "^echo\\s+===(\\s|$)"
            },
            {
              "pattern": "^ls\\b"
            },
            {
              "pattern": "^head\\b"
            },
            {
              "pattern": "^git\\s+add(\\s|$)"
            },
            {
              "pattern": "^find\\s+chezmoi(\\s|$)"
            },
            {
              "pattern": "^grep\\b"
            },
            {
              "pattern": "^command\\b"
            },
            {
              "pattern": "^true\\b"
            },
            {
              "pattern": "^nix\\s+eval(\\s|$)"
            },
            {
              "pattern": "^echo\\b"
            },
            {
              "pattern": "^strings\\b"
            }
          ]
        }
      }
    },
    "thinking_display": "always_collapsed",
    "auto_compact": {
      "threshold": "90%"
    },
    "default_model": {
      "provider": "opencode",
      "model": "go/deepseek-v4.1-flash",
      "enable_thinking": true,
      "effort": "high"
    }
  },
  "vim_mode": true,
  "buffer_font_fallbacks": ["Noto Sans Mono CJK SC"],
  "auto_install_extensions": { "nix": true },
  "languages": {
    "Nix": {
      "language_servers": ["nixd", "!nil"],
      "formatter": { "external": { "command": "nixfmt" } },
      "format_on_save": "on"
    }
  },
  "agent_servers": {
    "OpenCode": {
      "default_config_options": {
        "mode": "build",
        "effort": "high",
        "model": "opencode-go/deepseek-v4.1-flash"
      },
      "type": "custom",
      "command": "opencode",
      "args": ["acp"]
    }
  }
}
