{
  "git_panel": {
    "tree_view": true
  },
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light Soft",
    "dark": "Gruvbox Dark"
  },
  "agent_buffer_font_size": 14.0,
  "ui_font_size": 16.0,
  "ui_font_family": "Noto Sans Mono CJK SC",
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "terminal": {
    "font_family": "Hack"
  },
  "agent_buffer_font_family": "Noto Sans",
  "language_models": {
    "opencode": {
      "show_go_models": true,
      "show_zen_models": false,
      "available_models": [
        {
          "name": "deepseek-v4.1-flash",
          "display_name": "DeepSeek V4.1 Flash",
          "max_tokens": 1000000,
          "max_output_tokens": 384000,
          "subscription": "go",
          "reasoning_effort_levels": ["low", "high", "max"],
          "interleaved_reasoning": true
        }
      ]
    }
  },
  "agent": {
    "default_profile": "ask",
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    "tool_permissions": {
      "tools": {
        "fetch": {
          "always_allow": [
            { "pattern": "^https?://raw\\.githubusercontent\\.com" },
            { "pattern": "^https?://api\\.github\\.com" },
            { "pattern": "^https?://gist\\.githubusercontent\\.com" },
            { "pattern": "^https?://github\\.com" },
            { "pattern": "^https?://(docs\\.)?zed\\.dev" },
            { "pattern": "^https?://doc\\.rust-lang\\.org" },
            { "pattern": "^https?://docs\\.rs" },
            { "pattern": "^https?://crates\\.io" },
            { "pattern": "^https?://pkg\\.go\\.dev" },
            { "pattern": "^https?://developer\\.mozilla\\.org" },
            { "pattern": "^https?://docs\\.python\\.org" },
            { "pattern": "^https?://(www\\.)?npmjs\\.com" },
            { "pattern": "^https?://nixos\\.org" },
            { "pattern": "^https?://nix\\.dev" },
            { "pattern": "^https?://search\\.nixos\\.org" },
            { "pattern": "^https?://wiki\\.archlinux\\.org" },
            { "pattern": "^https?://stackoverflow\\.com" }
          ]
        },
        "terminal": {
          "always_allow": [
            { "pattern": "^git\\b" },
            { "pattern": "^ls\\b" },
            { "pattern": "^pwd\\b" },
            { "pattern": "^cat\\b" },
            { "pattern": "^bat\\b" },
            { "pattern": "^head\\b" },
            { "pattern": "^tail\\b" },
            { "pattern": "^wc\\b" },
            { "pattern": "^file\\b" },
            { "pattern": "^stat\\b" },
            { "pattern": "^readlink\\b" },
            { "pattern": "^realpath\\b" },
            { "pattern": "^dirname\\b" },
            { "pattern": "^basename\\b" },
            { "pattern": "^tree\\b" },
            { "pattern": "^find\\b" },
            { "pattern": "^fd\\b" },
            { "pattern": "^grep\\b" },
            { "pattern": "^rg\\b" },
            { "pattern": "^diff\\b" },
            { "pattern": "^sort\\b" },
            { "pattern": "^uniq\\b" },
            { "pattern": "^cut\\b" },
            { "pattern": "^jq\\b" },
            { "pattern": "^strings\\b" },
            { "pattern": "^sha256sum\\b" },
            { "pattern": "^md5sum\\b" },
            { "pattern": "^which\\b" },
            { "pattern": "^type\\b" },
            { "pattern": "^command\\b" },
            { "pattern": "^id\\b" },
            { "pattern": "^whoami\\b" },
            { "pattern": "^uname\\b" },
            { "pattern": "^printenv\\b" },
            { "pattern": "^date\\b" },
            { "pattern": "^df\\b" },
            { "pattern": "^du\\b" },
            { "pattern": "^free\\b" },
            { "pattern": "^ps\\b" },
            { "pattern": "^lsblk\\b" },
            { "pattern": "^echo\\b" },
            { "pattern": "^printf\\b" },
            { "pattern": "^true\\b" },
            { "pattern": "^false\\b" },
            { "pattern": "^nix\\s+(eval|search|build|why-depends|path-info|hash)\\b" },
            { "pattern": "^nix\\s+flake\\s+(show|metadata|check|archive)\\b" },
            { "pattern": "^nix\\s+store\\s+(verify|ping|ls|cat)\\b" },
            { "pattern": "^nix-instantiate\\b" },
            { "pattern": "^nixos-option\\b" },
            { "pattern": "^nixos-rebuild\\s+(build|dry-activate)\\b" },
            { "pattern": "^chezmoi\\s+(diff|status|managed|cat|source-path|data|verify|doctor)\\b" }
          ]
        }
      }
    },
    "thinking_display": "always_collapsed",
    "auto_compact": {
      "threshold": "90%"
    },
    "default_model": {
      "provider": "opencode",
      "model": "go/deepseek-v4.1-flash",
      "enable_thinking": true,
      "effort": "high"
    }
  },
  "vim_mode": true,
  "format_on_save": "on",
  "buffer_font_fallbacks": ["Noto Sans Mono CJK SC"],
  "auto_install_extensions": {
    "nix": true,
    "html": true,
    "toml": true,
    "tombi": true,
    "dockerfile": true,
    "xml": true,
    "php": true,
    "csharp": true,
    "zig": true,
    "lua": true,
    "latex": true,
    "just": true,
    "emmet": true
  },
  "languages": {
    "Nix": {
      "language_servers": ["nixd", "!nil"],
      "formatter": { "external": { "command": "nixfmt" } },
      "format_on_save": "on"
    }
  },
  "agent_servers": {
    "OpenCode": {
      "default_config_options": {
        "mode": "build",
        "effort": "high",
        "model": "opencode-go/deepseek-v4.1-flash"
      },
      "type": "custom",
      "command": "opencode",
      "args": ["acp"]
    }
  }
}
