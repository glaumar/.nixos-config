{
  "cli_default_open_behavior": "new_window",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "git_panel": {
    "tree_view": true
  },
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light Soft",
    "dark": "Gruvbox Dark"
  },
  "agent_buffer_font_size": 14.0,
  "ui_font_size": 16.0,
  "ui_font_family": "Noto Sans Mono CJK SC",
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "terminal": {
    "font_family": "Hack"
  },
  "agent_buffer_font_family": "Noto Sans",
  "language_models": {
    "opencode": {
      "show_go_models": true,
      "show_zen_models": false,
      "available_models": [
        {
          "name": "deepseek-v4.1-flash",
          "display_name": "DeepSeek V4.1 Flash",
          "max_tokens": 1000000,
          "max_output_tokens": 384000,
          "subscription": "go",
          "reasoning_effort_levels": ["low", "high", "max"],
          "interleaved_reasoning": true
        }
      ]
    }
  },
  "agent": {
    "default_profile": "write",
    "sandbox_permissions": {
      "network_hosts": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "zed.dev",
        "docs.zed.dev",
        "doc.rust-lang.org",
        "docs.rs",
        "crates.io",
        "pkg.go.dev",
        "developer.mozilla.org",
        "docs.python.org",
        "npmjs.com",
        "*.npmjs.com",
        "nixos.org",
        "*.nixos.org",
        "nix.dev",
        "wiki.archlinux.org",
        "stackoverflow.com",
        "ghostty.org",
        "carapace-sh.github.io"
      ],
      "allow_all_hosts": false,
      "allow_unsandboxed": false
    },
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "terminal": {
          "always_confirm": [
            { "pattern": "\\bsudo\\b" },
            { "pattern": "\\bnixos-rebuild\\s+(switch|boot|test)\\b" },
            { "pattern": "\\bnix-collect-garbage\\b" },
            { "pattern": "\\bjust\\s+(switch|repair|delete-generation)\\b" },
            { "pattern": "\\bsops\\b" },
            { "pattern": "\\brm\\s+(-[a-zA-Z]*r|--recursive)" },
            { "pattern": "\\bgit\\s+push\\b" }
          ]
        },
        "edit_file": {
          "always_confirm": [
            { "pattern": "(^|/)secrets/" },
            { "pattern": "\\.sops\\.yaml" }
          ]
        },
        "write_file": {
          "always_confirm": [
            { "pattern": "(^|/)secrets/" },
            { "pattern": "\\.sops\\.yaml" }
          ]
        },
        "delete_path": {
          "always_confirm": [
            { "pattern": "(^|/)secrets/" },
            { "pattern": "\\.sops\\.yaml" }
          ]
        },
        "move_path": {
          "always_confirm": [
            { "pattern": "(^|/)secrets/" },
            { "pattern": "\\.sops\\.yaml" }
          ]
        },
        "copy_path": {
          "always_confirm": [
            { "pattern": "(^|/)secrets/" },
            { "pattern": "\\.sops\\.yaml" }
          ]
        }
      }
    },
    "thinking_display": "always_collapsed",
    "auto_compact": {
      "threshold": "90%"
    },
    "default_model": {
      "provider": "opencode",
      "model": "go/deepseek-v4.1-flash",
      "enable_thinking": true,
      "effort": "high"
    }
  },
  "vim_mode": true,
  "format_on_save": "on",
  "buffer_font_fallbacks": ["Noto Sans Mono CJK SC"],
  "auto_install_extensions": {
    "nix": true,
    "html": true,
    "toml": true,
    "tombi": true,
    "dockerfile": true,
    "xml": true,
    "php": true,
    "csharp": true,
    "zig": true,
    "lua": true,
    "latex": true,
    "just": true,
    "emmet": true
  },
  "languages": {
    "Nix": {
      "language_servers": ["nixd", "!nil"],
      "formatter": { "external": { "command": "nixfmt" } },
      "format_on_save": "on"
    }
  },
  "lsp": {
    "rust-analyzer": {
      "binary": {
        "path": "/run/current-system/sw/bin/rust-analyzer"
      }
    }
  },
  "agent_servers": {
    "OpenCode": {
      "default_config_options": {
        "mode": "build",
        "effort": "high",
        "model": "opencode-go/deepseek-v4.1-flash"
      },
      "type": "custom",
      "command": "opencode",
      "args": ["acp"]
    }
  }
}
